# Copy to .env and fill in your Aqara RTSP endpoints.
# .env is gitignored — keep your real IPs/credentials out of the repo.
# Enable RTSP in the Aqara Home app (camera -> Settings -> RTSP).
# The entrypoint composes rtsp://USER:PASS@HOST:PORT/PATH from these fields.

DOORBELL_RTSP_URL=rtsp://192.168.1.50:8554/ch1
DOORBELL_RTSP_USERNAME=user
DOORBELL_RTSP_PASSWORD=pass

G100_RTSP_URL=rtsp://192.168.1.51:8554/ch1
G100_RTSP_USERNAME=user
G100_RTSP_PASSWORD=pass
