# Rendered at container start by nginx's envsubst (only ${GO2RTC_UPSTREAM} is
# substituted; nginx runtime vars like $http_upgrade are left untouched).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # go2rtc endpoints the browser uses: /api/ws (WebRTC signaling, WebSocket),
    # /api/stream.m3u8 (HLS for casting), /api/frame.jpeg. Proxied here so the
    # whole app is one origin and works behind an HTTPS reverse proxy.
    location /api/ {
        proxy_pass http://${GO2RTC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
